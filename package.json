{
    "name": "vscode-h2o",
    "displayName": "Shell Script Command Completion",
    "version": "0.2.15",
    "description": "Complete shell commands and view inline help in shell scripts and BitBake files",
    "repository": {
        "url": "https://github.com/yamaton/vscode-h2o"
    },
    "publisher": "tetradresearch",
    "author": {
        "name": "Yamato Matsuoka",
        "email": "yamato.matsuoka@tritonlab.io"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "icon": "images/animal_chara_computer_penguin.png",
    "keywords": [
        "shellscript",
        "completion",
        "autocomplete",
        "intellisense",
        "cli",
        "bioinformatics",
        "hover",
        "bitbake",
        "shell",
        "bash",
        "h2o"
    ],
    "activationEvents": [
        "onLanguage:shellscript",
        "onLanguage:bitbake"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "h2o.clearCache",
                "title": "Shell Completion: Remove Command Spec"
            },
            {
                "command": "h2o.loadCommon",
                "title": "Shell Completion: Load All Common CLI Specs"
            },
            {
                "command": "h2o.loadBio",
                "title": "Shell Completion: Load All Bioinformatics CLI Specs"
            },
            {
                "command": "h2o.removeBio",
                "title": "Shell Completion: Remove All Bioinformatics CLI Specs"
            },
            {
                "command": "h2o.loadCommand",
                "title": "Shell Completion: Load Command Spec (experimental)"
            },
            {
                "command": "registeredCommands.refreshEntry",
                "title": "Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "registeredCommands.removeEntry",
                "title": "Remove",
                "icon": "$(trash)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "h2o.clearCache",
                    "when": "editorLangId == shellscript || editorLangId == bitbake"
                },
                {
                    "command": "h2o.loadCommon",
                    "when": "editorLangId == shellscript || editorLangId == bitbake"
                },
                {
                    "command": "h2o.loadBio",
                    "when": "editorLangId == shellscript || editorLangId == bitbake"
                },
                {
                    "command": "h2o.removeBio",
                    "when": "editorLangId == shellscript || editorLangId == bitbake"
                },
                {
                    "command": "h2o.loadCommand",
                    "when": "editorLangId == shellscript || editorLangId == bitbake"
                }
            ],
            "view/title": [
                {
                    "command": "registeredCommands.refreshEntry",
                    "when": "view == registeredCommands",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "registeredCommands.removeEntry",
                    "when": "view == registeredCommands",
                    "group": "inline"
                },
                {
                    "command": "registeredCommands.removeEntry",
                    "when": "view == registeredCommands"
                }
            ]
        },
        "configuration": {
            "title": "Shell Completion",
            "properties": {
                "shellCompletion.h2oPath": {
                    "type": "string",
                    "default": "<bundled>",
                    "description": "Path to the H2O executable. Enter <bundled> if using the bundled."
                }
            }
        },
        "views": {
            "explorer": [
                {
                    "id": "registeredCommands",
                    "name": "Shell Commands",
                    "visibility": "collapsed"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "check:unit": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run test:release-tools",
        "clean": "node scripts/clean.mjs out coverage artifacts",
        "clean:build": "node scripts/clean.mjs out",
        "clean:coverage": "node scripts/clean.mjs coverage",
        "clean:artifacts": "node scripts/clean.mjs artifacts",
        "build": "npm run clean:build && npm run compile",
        "compile": "tsc -p ./",
        "typecheck": "tsc --noEmit -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run lint && npm run typecheck && npm run build",
        "lint": "eslint src --ext ts --max-warnings=0",
        "test": "npm run test:unit && npm run test:integration",
        "test:coverage": "npm run clean:coverage && c8 --check-coverage --lines 80 --statements 80 --branches 80 --functions 75 --include out/cacheFetcher.js --include out/utils.js npm run test:unit",
        "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
        "test:integration": "node ./out/test/runTest.js",
        "test:vsix": "node ./out/test/runVsixTest.js artifacts/vscode-h2o-linux-x64.vsix",
        "audit:prod": "npm audit --omit=dev --audit-level=high",
        "test:release-tools": "node scripts/test-h2o-release.mjs && node scripts/test-release-tag.mjs && node scripts/test-marketplace-release.mjs",
        "h2o:verify-release": "node scripts/verify-h2o-release.mjs",
        "h2o:fetch": "node scripts/fetch-h2o.mjs",
        "verify:native": "node scripts/verify-native.mjs",
        "package:platform": "node scripts/package-platform.mjs",
        "package:vsix": "npm run package:platform -- --target linux-x64",
        "verify:vsix": "node scripts/verify-vsix.mjs artifacts/vscode-h2o-linux-x64.vsix linux-x64",
        "package:verify": "npm run package:vsix",
        "verify:release-artifacts": "node scripts/publish-marketplace.mjs --verify-only",
        "publish:marketplace": "node scripts/publish-marketplace.mjs"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.15.35",
        "@types/node-fetch": "^2.6.12",
        "@types/vscode": "1.101.0",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "c8": "^12.0.0",
        "eslint": "^10.9.1",
        "mocha": "^11.8.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "node-fetch": "^2.6.6",
        "web-tree-sitter": "^0.20.8"
    }
}
